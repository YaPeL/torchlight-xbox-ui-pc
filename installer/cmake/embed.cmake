# Writes OUT, a C++ file holding every file under DIR (data/prompts: Kenney's icons, CC0) as byte
# arrays with their paths relative to DIR, for x360ui::prompt_file. Run by the build (cmake -P).
file(GLOB_RECURSE files RELATIVE "${DIR}" "${DIR}/*.png")
list(SORT files)
set(body "// Generated by installer/cmake/embed.cmake from data/prompts: do not edit.\n#include \"prompts.h\"\n#include <cstring>\nnamespace x360ui {\nnamespace {\n")
set(table "")
set(n 0)
foreach(f ${files})
  file(READ "${DIR}/${f}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "const unsigned char d${n}[] = {${hex}};\n")
  string(APPEND table "    {\"${f}\", d${n}, sizeof d${n}},\n")
  math(EXPR n "${n} + 1")
endforeach()
string(APPEND body "struct Entry { const char* name; const unsigned char* data; size_t size; };\nconst Entry entries[] = {\n${table}};\n}  // namespace\n")
string(APPEND body "const Bytes* prompt_file(const std::string& name) {\n  static std::vector<Bytes> cache(sizeof entries / sizeof entries[0]);\n  for (size_t i = 0; i < sizeof entries / sizeof entries[0]; i++)\n    if (name == entries[i].name) {\n      if (cache[i].empty()) cache[i].assign(entries[i].data, entries[i].data + entries[i].size);\n      return &cache[i];\n    }\n  return nullptr;\n}\n}  // namespace x360ui\n")
file(WRITE "${OUT}" "${body}")
